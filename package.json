{
  "name": "dsh-whale-weather",
  "version": "0.3.2",
  "description": "Caring weather tool for DeepSeek Harness (dsh): forecast + air quality, personalized to who you are and what time it is (umbrella / clothing / wind / heat / AQI), with a local preference profile. Free, no API key.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./care": "./lib/care.js",
    "./profile": "./lib/profile.js",
    "./weather": "./lib/weather.js",
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./providers": "./lib/providers.js",
    "./reminders": "./lib/reminders.js",
    "./alerts": "./lib/alerts.js",
    "./openmeteo": "./lib/openmeteo.js"
  },
  "files": [
    "lib/**/*.js",
    "scripts/demo.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "demo": "node scripts/demo.mjs 合肥"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "weather",
    "weather-forecast",
    "air-quality",
    "wttr",
    "weather-alerts",
    "reminders",
    "care",
    "assistant"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "fanyingnie2163663",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanyingnie2163663/dsh-whale-weather.git"
  },
  "homepage": "https://github.com/fanyingnie2163663/dsh-whale-weather#readme",
  "bugs": {
    "url": "https://github.com/fanyingnie2163663/dsh-whale-weather/issues"
  }
}
