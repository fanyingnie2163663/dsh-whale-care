{
  "name": "dsh-whale-care",
  "version": "0.5.0",
  "description": "Care engine for DeepSeek Harness (dsh): teaches the assistant to actually care about one person, with weather as its first and cheapest source. Personalized forecast + air quality, umbrella/clothing/wind/heat/AQI advice, reminders, extreme-weather alerts, local preference profile. Free, no API key.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    "./care": "./lib/care.js",
    "./profile": "./lib/profile.js",
    "./weather": "./lib/weather.js",
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./providers": "./lib/providers.js",
    "./reminders": "./lib/reminders.js",
    "./alerts": "./lib/alerts.js",
    "./openmeteo": "./lib/openmeteo.js"
  },
  "files": [
    "lib/**/*.js",
    "scripts/demo.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "demo": "node scripts/demo.mjs 合肥"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "weather",
    "weather-forecast",
    "air-quality",
    "wttr",
    "weather-alerts",
    "reminders",
    "care",
    "companion",
    "assistant"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "fanyingnie2163663",
  "repository": {
    "type": "git",
